{
  "name": "react",
  "version": "1.0.0",
  "description": "React example starter project",
  "homepage": "https://nhttoan0809.github.io/BCS-YEP-2024",
  "keywords": [
    "react",
    "starter"
  ],
  "main": "src/index.js",
  "dependencies": {
    "react": "16.12.0",
    "react-dom": "16.12.0",
    "react-router-dom": "5.1.2",
    "react-scripts": "3.0.1",
    "firebase": "11.1.0",
    "firebase-functions": "6.2.0",
    "firebase-admin": "13.0.2",
    "async_hooks": "1.0.0"
  },
  "devDependencies": {
    "tailwindcss": "1.0.4"
  },
  "scripts": {
    "autoprefixer": "9.6.0",
    "postcss": "7.0.17",
    "build:style": "tailwind build src/styles/index.pcss -c tailwind.js -o src/styles/tailwind-pre-build.css",
    "start": "react-scripts start",
    "build": "react-scripts build && cp build/index.html build/404.html && touch build/.nojekyll",
    "test": "react-scripts test --watchAll=false --passWithNoTests",
    "eject": "react-scripts eject"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
